CLIENT_TOKEN=

# feature based
# provider://[key@]host[:port][/base]/model[?fallback=..&thinking=..]
# exp:
#   AI_URL=ollama://localhost:11434/disaity-e2b
#   AI_URL=gemini://YOUR_KEY@default/gemini-3.5-flash-lite?fallback=gemini-3.1-flash-lite
#   AI_URL=anthropic://YOUR_KEY@default/claude-sonnet-5-5
#   AI_URL=openai://YOUR_KEY@api.groq.com/openai/v1/llama-3.3-70b
AI_URL=
# database local location
#   DB_PATH=./db
DB_PATH=

# trace | debug | info | warn | error — unset means no logs at all
LOG_LEVEL=

# bypass the bin check and overwrite the bin location
DISAITY_FFMPEG=
DISAITY_YTDLP=

# Over write the whole bot tree
DISAITY_HOME=
