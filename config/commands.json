{
  "play": {
    "name": "play",
    "keys": ["play", "p"],
    "category": "music",
    "description": "Play's an audio.",
    "timeout": 40,
    "options": [
      {
        "name": "song",
        "description": "Enter song name",
        "type": 3,
        "required": true
      }
    ]
  },

  "stop": {
    "name": "stop",
    "keys": ["stop", "st"],
    "category": "music",
    "description": "Stop's playing."
  },

  "skip": {
    "name": "skip",
    "keys": ["skip", "s"],
    "category": "music",
    "description": "Skip's the current song."
  },

  "seek": {
    "name": "seek",
    "keys": ["seek", "sk"],
    "category": "music",
    "description": "Seek's the current song.",
    "options": [
      {
        "name": "time",
        "description": "Enter time in seconds.",
        "type": 4,
        "required": true
      }
    ]
  },

  "clear": {
    "name": "clear",
    "keys": ["clear", "c"],
    "category": "music",
    "description": "Clears the queue."
  },

  "join": {
    "name": "join",
    "keys": ["join", "j"],
    "category": "others",
    "description": "I will join your channel."
  },

  "leave": {
    "name": "leave",
    "keys": ["leave", "l"],
    "category": "others",
    "description": "I will leave your channel."
  },

  "pause": {
    "name": "pause",
    "keys": ["pause", "ps"],
    "category": "music",
    "description": "Pause's the current song."
  },

  "resume": {
    "name": "resume",
    "keys": ["resume", "r"],
    "category": "music",
    "description": "Resume's the current song."
  },

  "repeat": {
    "name": "repeat",
    "keys": ["repeat", "rp"],
    "category": "music",
    "description": "Repeat queue or song you are playing.",
    "options": [
      {
        "name": "repeat",
        "choices": [
          {
            "name": "song",
            "value": "song"
          },
          {
            "name": "toggle",
            "value": "toggle"
          },
          {
            "name": "disable",
            "value": "disable"
          }
        ],
        "description": "Repeat's a song",
        "type": 3,
        "required": true
      }
    ]
  },

  "queue": {
    "name": "queue",
    "keys": ["queue", "q"],
    "category": "music",
    "description": "Displays the current queue."
  },

  "shuffle": {
    "name": "shuffle",
    "keys": ["shuffle", "sh"],
    "category": "music",
    "description": "Shuffle's the queue."
  },

  "volume": {
    "name": "volume",
    "keys": ["volume", "v"],
    "category": "music",
    "description": "Change's the volume.",
    "options": [
      {
        "name": "percentage ",
        "description": "Enter value from 0 to 100",
        "type": 4,
        "min_value": 0,
        "max_value": 100,
        "required": true
      }
    ]
  },

  "jump": {
    "name": "jump",
    "keys": ["jump", "jp"],
    "category": "music",
    "description": "Jump's to the song.",
    "options": [
      {
        "name": "jump",
        "description": "Enter song number.",
        "type": 4,
        "required": true
      }
    ]
  },

  "ask": {
    "name": "ask",
    "keys": ["ask", "a"],
    "category": "chat",
    "description": "Emilia will answer you.",
    "options": [
      {
        "name": "chat",
        "description": "Take to me.",
        "type": 3,
        "required": true
      }
    ]
  },

  "help": {
    "name": "help",
    "keys": ["help", "h"],
    "category": "others",
    "description": "Displays all the commands. ⌘",
    "action": "help_menu"
  }
}
