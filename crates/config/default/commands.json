{
  "play": {
    "name": "play",
    "keys": ["play", "p"],
    "category": "music",
    "description": "Play's an audio.",
    "timeout": 40,
    "ai": "general",
    "options": [
      {
        "name": "song",
        "description": "Enter song name",
        "type": 3,
        "required": true
      }
    ]
  },

  "stop": {
    "name": "stop",
    "keys": ["stop", "st"],
    "category": "music",
    "description": "Stop's playing.",
    "ai": "general"
  },

  "skip": {
    "name": "skip",
    "keys": ["skip", "s"],
    "category": "music",
    "description": "Skip's the current song.",
    "ai": "general"
  },

  "seek": {
    "name": "seek",
    "keys": ["seek", "sk"],
    "category": "music",
    "description": "Seek's the current song.",
    "ai": "general",
    "options": [
      {
        "name": "time",
        "description": "Enter time in seconds.",
        "type": 4,
        "required": true
      }
    ]
  },

  "clear": {
    "name": "clear",
    "keys": ["clear", "c"],
    "category": "music",
    "description": "Clears the queue.",
    "ai": "general"
  },

  "join": {
    "name": "join",
    "keys": ["join", "j"],
    "category": "other",
    "description": "I will join your channel.",
    "ai": "general"
  },

  "leave": {
    "name": "leave",
    "keys": ["leave", "l"],
    "category": "other",
    "description": "I will leave your channel.",
    "ai": "general"
  },

  "pause": {
    "name": "pause",
    "keys": ["pause", "ps"],
    "category": "music",
    "description": "Pause's the current song.",
    "ai": "general"
  },

  "resume": {
    "name": "resume",
    "keys": ["resume", "r"],
    "category": "music",
    "description": "Resume's the current song.",
    "ai": "general"
  },

  "repeat": {
    "name": "repeat",
    "keys": ["repeat", "rp"],
    "category": "music",
    "description": "Repeat queue or song you are playing.",
    "ai": "general",
    "options": [
      {
        "name": "repeat",
        "choices": [
          {
            "name": "song",
            "value": "song"
          },
          {
            "name": "toggle",
            "value": "toggle"
          },
          {
            "name": "disable",
            "value": "disable"
          }
        ],
        "description": "Repeat's a song",
        "type": 3,
        "required": true
      }
    ]
  },

  "queue": {
    "name": "queue",
    "keys": ["queue", "q"],
    "category": "music",
    "description": "Displays the current queue.",
    "ai": "general"
  },

  "shuffle": {
    "name": "shuffle",
    "keys": ["shuffle", "sh"],
    "category": "music",
    "description": "Shuffle's the queue.",
    "ai": "general"
  },

  "volume": {
    "name": "volume",
    "keys": ["volume", "v"],
    "category": "music",
    "description": "Change's the volume.",
    "ai": "general",
    "options": [
      {
        "name": "percentage ",
        "description": "Enter value from 0 to 100",
        "type": 4,
        "min_value": 0,
        "max_value": 100,
        "required": true
      }
    ]
  },

  "jump": {
    "name": "jump",
    "keys": ["jump", "jp"],
    "category": "music",
    "description": "Jump's to the song.",
    "ai": "general",
    "options": [
      {
        "name": "jump",
        "description": "Enter song number.",
        "type": 4,
        "required": true
      }
    ]
  },

  "ask": {
    "name": "ask",
    "keys": ["ask", "a"],
    "category": "chat",
    "description": "Ask any question, I will answer you.",
    "ai": "never",
    "options": [
      {
        "name": "chat",
        "description": "Take to me.",
        "type": 3,
        "required": true
      }
    ]
  },

  "assist": {
    "name": "assist",
    "keys": ["assist", "ai"],
    "category": "chat",
    "description": "Tell me what you need and I'll run the right commands.",
    "timeout": 60,
    "ai": "never",
    "options": [
      {
        "name": "request",
        "description": "Tell me what you want, Will help you.",
        "type": 3,
        "required": true
      }
    ]
  },

  "help": {
    "name": "help",
    "keys": ["help", "h"],
    "category": "other",
    "description": "Displays all the commands. ⌘",
    "action": "help_menu",
    "ai": "never"
  },

  "free_games": {
    "name": "free_games",
    "keys": ["free_games", "fg"],
    "category": "subscription",
    "description": "Subscribe to free games in all (platforms) in target a chennel and ping a role.",
    "timeout": 40,
    "ai": "general",

    "options": [
      {
        "name": "channel",
        "description": "Enter the channel id you want to send the notification on.",
        "type": 3,
        "required": true
      },
      {
        "name": "role",
        "description": "Enter the role id you want to to ping it. (optinal)",
        "type": 3,
        "required": false
      }
    ]
  },

  "clear_free_games": {
    "name": "clear_free_games",
    "keys": ["clear_free_games", "cfg"],
    "category": "subscription",
    "description": "Unsubscribe to free games in the server",
    "timeout": 40,
    "ai": "general"
  },

  "kick": {
    "name": "kick",
    "keys": ["kick", "k"],
    "category": "manage",
    "description": "Kick a member from the server.",
    "ai": "general",
    "options": [
      {
        "name": "member",
        "description": "Who to kick.",
        "type": 6,
        "required": true
      },
      {
        "name": "reason",
        "description": "Why, shown in the audit log.",
        "type": 3,
        "required": true
      }
    ]
  },

  "move_member": {
    "name": "move_member",
    "keys": ["move_member", "mv"],
    "category": "manage",
    "description": "Move a member to another voice channel.",
    "ai": "general",
    "options": [
      {
        "name": "member",
        "description": "Who to move.",
        "type": 6,
        "required": true
      },
      {
        "name": "channel",
        "description": "The voice channel id to move them to.",
        "type": 3,
        "required": true
      }
    ]
  }
}
